{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Muss mit dem Namen des Workers im Cloudflare-Dashboard übereinstimmen.
  "name": "kbs-cannonhill",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-15",
  // Erreichbar unter kbs-cannonhill.<konto>.workers.dev; keine Vorschau-Adressen pro Version.
  "workers_dev": true,
  "preview_urls": false,
  // Webseiten (Beamer, Handy) kommen direkt aus public/.
  // Nur /ws/<raumcode> (Netztest) und /spiel/<raumcode> (Turnier) landen im Worker-Code.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Ein Durable Object pro Klassenraum: hält alle WebSocket-Verbindungen
  // und gibt den Takt vor (Raum = Netztest, Turnier = das Spiel).
  "durable_objects": {
    "bindings": [
      { "name": "RAUM", "class_name": "Raum" },
      { "name": "TURNIER", "class_name": "Turnier" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Raum"] },
    { "tag": "v2", "new_sqlite_classes": ["Turnier"] }
  ]
}
